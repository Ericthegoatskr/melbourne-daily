{
  "name": "melbourne-daily",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:api": "node scripts/build-api.mjs",
    "build:transit-api": "node scripts/build-transit-api.mjs",
    "build:epa-collector": "node scripts/build-epa-collector.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run test && npm run build && npm run build:api && npm run build:transit-api && npm run build:epa-collector",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
